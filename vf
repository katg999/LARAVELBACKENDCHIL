#!/bin/bash

# Smart VoiceFlow Simulation Wrapper
# Auto-detects whether to use Docker or local Laravel

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Check if Docker containers are running
if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^laravel_app$"; then
    # Docker is running, use it
    echo -e "${BLUE}🐳 Docker detected, using Docker environment${NC}"
    
    if command -v docker-compose &> /dev/null; then
        docker-compose exec app php artisan voiceflow:simulate "$@"
    else
        docker exec -it laravel_app php artisan voiceflow:simulate "$@"
    fi
else
    # Docker not running, check if local server is available
    echo -e "${BLUE}💻 Docker not running, using local environment${NC}"
    
    # Check if local server is running on port 8000
    if curl -s -o /dev/null -w "%{http_code}" http://localhost:8000 2>/dev/null | grep -q "^[23]"; then
        echo -e "${GREEN}✓${NC} Local server detected on port 8000"
    else
        echo -e "${YELLOW}⚠️  Warning: No server detected on http://localhost:8000${NC}"
        echo -e "${YELLOW}You may need to start the dev server first:${NC}"
        echo -e "${YELLOW}  php artisan serve --host=0.0.0.0 --port=8000${NC}"
        echo ""
    fi
    
    php artisan voiceflow:simulate "$@"
fi
